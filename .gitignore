# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# Build output
build/
dist/
bin/
atwa.spec
cli.spec

# Ship prebuilt native binaries inside the package (do not ignore).
!src/atwa/bin/
!src/atwa/bin/*

# Editor swap/backup files
*.swp
*.swo
*~

# IDE
.idea/
Pycharm/

# Captures and cracked credentials — never commit
*.pcap
*.pcapng
*.cap
*.hccapx
*.22000

# Code knowledge graph — regenerable dev-tooling output, rebuilt locally by
# the post-commit hook. Not published.
graphify-out/

# Internal docs & working files — never commit
AGENTS.md
USAGE.md
STATUS.md
CHECKPOINT.md

# Test & tooling directories
tests/
tools/

# Local captures & logs
gui_shot.log
repo_dump.md
creds.json

# Local configs
.env
*.local.*
.vscode/
